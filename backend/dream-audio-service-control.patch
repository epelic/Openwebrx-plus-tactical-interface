+void CStatusBroadcast::ReadClientCommands()
+{
+#ifndef _WIN32
+    if (pDRMReceiver == nullptr)
+        return;
+
+    char buffer[128];
+    for (int fd : vecClientFds)
+    {
+        ssize_t count = recv(fd, buffer, sizeof(buffer) - 1, MSG_DONTWAIT);
+        if (count <= 0)
+            continue;
+        buffer[count] = '\0';
+        int service = -1;
+        if (sscanf(buffer, "audio_service=%d", &service) == 1 && service >= 0 && service < 4)
+        {
+            pDRMReceiver->GetParameters()->SetCurSelAudioService(service);
+            fprintf(stderr, "StatusBroadcast: Selected audio service %d\n", service);
+        }
+    }
+#endif
+}
